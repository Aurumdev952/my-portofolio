{
  "name": "forge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node init && vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "node init && node scripts/build-sitemap.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/prepare-portrait.mjs && node scripts/shoot-sites.mjs",
    "og": "node scripts/build-og.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "nitro": "3.0.260610-beta",
    "postprocessing": "^6.39.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.32.1",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.20.0",
    "playwright": "^1.64.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
